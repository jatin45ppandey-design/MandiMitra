APP_ENV=development
CORS_ORIGINS=http://localhost:5173
DATA_GOV_BASE_URL=https://api.data.gov.in
AGMARKNET_RESOURCE_ID=9ef84268-d588-465a-a308-a864a43d0070
DATA_GOV_API_KEY=REPLACE_WITH_NEW_DATA_GOV_API_KEY
# Government API may be slow; retry only once by default.
DATA_GOV_TIMEOUT_SECONDS=45
DATA_GOV_MAX_RETRIES=1

# Road routing: server-side only, never VITE_* or a checked-in credential.
OPENROUTESERVICE_API_KEY=REPLACE_WITH_OPENROUTESERVICE_API_KEY

# Use snapshot without credentials; set postgres only after provisioning Supabase.
DATABASE_BACKEND=snapshot
DATABASE_URL=REPLACE_WITH_SUPABASE_POSTGRES_CONNECTION_STRING
SUPABASE_URL=REPLACE_WITH_SUPABASE_PROJECT_URL
SUPABASE_PUBLISHABLE_KEY=REPLACE_WITH_SUPABASE_PUBLISHABLE_KEY
# Legacy alternative: SUPABASE_ANON_KEY=

# Future channels, not activated by these placeholders
WHATSAPP_ACCESS_TOKEN=REPLACE_LATER
WHATSAPP_PHONE_NUMBER_ID=REPLACE_LATER
SMS_API_KEY=REPLACE_LATER

# Optional grounded Gemma advisor. Keep key backend-only.
GEMINI_API_KEY=
GEMMA_MODEL=gemma-4-26b-a4b-it
GEMMA_ENABLED=false
